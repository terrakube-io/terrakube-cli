    [ -n "$TERRAKUBE_TEST_ORG_ID" ] || skip "Organization ID not available"
    [ -n "$TERRAKUBE_TEST_WS_ID" ] || skip "Workspace ID not available"
    [ -n "$TERRAKUBE_TEST_WEBHOOK_ID" ] || skip "Webhook ID not available"
